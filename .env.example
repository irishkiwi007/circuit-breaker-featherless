# Copy this to .env and fill in real values. .env is gitignored — never commit real keys.

ALPACA_API_KEY=your_paper_account_key_id
ALPACA_SECRET_KEY=your_paper_account_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# LLM_PROVIDER selects the backend in agent_layer/llm_client.py:
#   "anthropic"   (default) — uses ANTHROPIC_API_KEY + ANTHROPIC_MODEL below
#   "featherless" — uses FEATHERLESS_API_KEY + LLM_MODEL below
LLM_PROVIDER=featherless

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Only needed if LLM_PROVIDER=featherless
FEATHERLESS_API_KEY=your_featherless_api_key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro
